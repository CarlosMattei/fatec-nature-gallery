                {
                  "type": "text",
                  "id": "aDSQm",
                  "name": "Descricao",
                  "fill": "#86603aff",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "O Fatec Nature Gallery e um projeto colaborativo desenvolvido para catalogar, geolocalizar e documentar a rica diversidade de plantas e arvores em nosso campus. Nosso objetivo e sensibilizar a comunidade academica sobre a importancia da conservacao ambiental por meio de uma experiencia digital interativa.",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "fontWeight": "normal"
                }
              ]
            },
